FROM python:3.11-slim

# System deps for eccodes/cfgrib
RUN apt-get update && apt-get install -y --no-install-recommends \
    libeccodes-dev \
    libeccodes0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /batch

COPY scripts/build_ens_meteogram.py /batch/build_ens_meteogram.py

RUN pip install --no-cache-dir \
    ecmwf-opendata \
    xarray \
    cfgrib \
    numpy \
    matplotlib

# Default output path inside the container — override with ENS_OUTPUT env var
# The plots directory is mounted at /plots from the host.
ENV ENS_OUTPUT=/plots/ens_meteogram.png

# Run every 6 hours: attempt once, then sleep before the next attempt
# regardless of success or failure (avoids tight retry loops on persistent errors).
CMD ["sh", "-c", "while true; do python /batch/build_ens_meteogram.py --output \"$ENS_OUTPUT\" || echo '[ens-batch] Run failed, will retry after 6 h'; sleep 21600; done"]
